# Copy to .env.local. Load server-side only. Never commit .env.local.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_SPARK_MODEL=muse-spark-1.3

# Optional: protect a hosted single-user demo (login name is judge).
DEMO_PASSWORD=
# Heroku provides PORT. Use one browser context at a time on small dynos.
BREAKIT_RENDER_CONCURRENCY=1
