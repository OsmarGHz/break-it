{
  "name": "break-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adversarial HTML/CSS component stress-testing workbench powered by Muse Spark 1.3 and Playwright Chromium.",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:fixtures": "tsx scripts/verify-fixtures.ts",
    "verify:spark": "tsx scripts/verify-live-spark.ts",
    "verify:ui": "tsx scripts/verify-ui-e2e.ts",
    "verify:evidence": "tsx scripts/verify-evidence.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "cheerio": "^1.0.0",
    "diff": "^7.0.0",
    "esbuild": "0.28.2",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "playwright": "1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
